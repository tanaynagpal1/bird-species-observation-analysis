# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Streamlit local secrets (never commit credentials)
.streamlit/secrets.toml

# Notebook checkpoints
.ipynb_checkpoints/

# Scratch
*.log
*.tmp
~$*

# NOTE: data/ is deliberately NOT ignored.
# The Streamlit Cloud deployment reads data/processed/*.csv directly, so those
# files have to be in the repo for the hosted app to start. They total about
# 13 MB, which is well inside GitHub's limits. data/raw/*.xlsx (2 MB) is kept
# too so the whole pipeline can be re-run from source by anyone who clones it.
#
# docs/*.pdf and docs/*.docx are also committed on purpose: they are the
# deliverable, and committing them means a reader can download the report
# without installing Python or running the generator.